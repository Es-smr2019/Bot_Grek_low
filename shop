@router.message(lambda msg: msg.text and msg.text.lower().startswith("+зелье "))
async def cmd_buy_potion(message: Message):
    name = message.text[7:].strip().lower()
    prices = {"плод любви": 100}
    if name not in prices:
        return await message.reply("Такого зелья нет.")
    async with async_session() as session:
        user = await get_or_create_user(session, message.from_user.id)
        if user.sparkles < prices[name]:
            return await message.reply("❌ Недостаточно сияний.")
        user.sparkles -= prices[name]
        # добавляем в инвентарь
        inv = await session.execute(
            select(InventoryItem).where(
                InventoryItem.user_id == user.telegram_id,
                InventoryItem.item_name == name
            )
        )
        item = inv.scalar_one_or_none()
        if item:
            item.quantity += 1
        else:
            item = InventoryItem(user_id=user.telegram_id, item_name=name, quantity=1)
            session.add(item)
        await session.commit()
    await message.reply(f"🧪 <b>{name}</b> куплено!")


@router.message(lambda msg: msg.text and msg.text.lower().startswith("свести пару "))
async def cmd_love_potion(message: Message):
    # свести пару @user1 @user2
    parts = message.text.split()
    if len(parts) < 4:
        return await message.reply("Формат: свести пару @user1 @user2")
    async with async_session() as session:
        user = await get_or_create_user(session, message.from_user.id)
        inv = await session.execute(
            select(InventoryItem).where(
                InventoryItem.user_id == user.telegram_id,
                InventoryItem.item_name == "плод любви"
            )
        )
        item = inv.scalar_one_or_none()
        if not item or item.quantity <= 0:
            return await message.reply("❌ Нужно зелье 'Плод любви'. Купите в таверне.")
        item.quantity -= 1
        if item.quantity == 0:
            await session.delete(item)
        await session.commit()
    await message.reply(
        f"💘 <b>Плод любви</b> использован!\n\n"
        f"Пользователи {parts[2]} и {parts[3]} теперь в браке! (упрощённо)"
    )
