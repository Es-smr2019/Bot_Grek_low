@router.message(Command("+питомец"))
async def cmd_buy_pet(message: Message):
    async with async_session() as session:
        user = await get_or_create_user(session, message.from_user.id)
        if user.coins < 500 or user.sparkles < 50:
            return await message.reply("❌ Недостаточно средств (500💰 + 50✨).")
        existing = await session.execute(
            select(Pet).where(Pet.user_id == user.telegram_id)
        )
        if existing.scalar_one_or_none():
            return await message.reply("❌ У вас уже есть питомец.")
        user.coins -= 500
        user.sparkles -= 50
        pet = Pet(user_id=user.telegram_id, name="Мики", element="огонь")
        session.add(pet)
        await session.commit()
    await message.reply("🐾 <b>Питомец Мики</b> куплен! Используйте <code>мой питомец</code>.")


