@router.message(lambda msg: msg.text and msg.text.lower().startswith("+кличка "))
async def cmd_pet_name(message: Message):
    name = message.text[9:].strip()
    if not name:
        return await message.reply("Введите имя: <code>+кличка НовоеИмя</code>")
    async with async_session() as session:
        result = await session.execute(select(Pet).where(Pet.user_id == message.from_user.id))
        pet = result.scalar_one_or_none()
        if not pet:
            return await message.reply("❌ У вас нет питомца.")
        pet.name = name[:30]
        await session.commit()
    await message.reply(f"✅ Питомец теперь зовётся <b>{name}</b>!")


