# --- Ник ---
@router.message(lambda msg: msg.text and msg.text.lower().startswith("+ник "))
async def cmd_set_nick(message: Message):
    nick = message.text[5:].strip()
    if not nick:
        return await message.reply("Введите ник: <code>+ник НовыйНик</code>")
    if len(nick) > 30:
        return await message.reply("❌ Максимум 30 символов.")
    async with async_session() as session:
        user = await get_or_create_user(session, message.from_user.id)
        user.nick = nick
        await session.commit()
    await message.reply(f"✅ Ник изменён на <b>{nick}</b>!")


