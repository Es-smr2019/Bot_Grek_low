@router.message(lambda msg: msg.text and msg.text.lower().startswith("инфо "))
async def cmd_user_info_chat(message: Message):
    target_id = None
    if message.reply_to_message:
        target_id = message.reply_to_message.from_user.id
    elif len(message.text.split()) >= 2 and message.text.split()[1].startswith("@"):
        uname = message.text.split()[1].replace("@", "")
        async with async_session() as session:
            res = await session.execute(select(User).where(User.username == uname))
            u = res.scalar_one_or_none()
            if u:
                target_id = u.telegram_id
    if not target_id:
        return await message.reply("Укажите пользователя.")
    async with async_session() as session:
        u = await get_or_create_user(session, target_id)
        cs = await session.execute(
            select(ChatStat).where(ChatStat.chat_id == message.chat.id, ChatStat.user_id == target_id)
        )
        stat = cs.scalar_one_or_none()
        msgs = stat.messages if stat else 0
        wins = stat.wins if stat else 0
        losses = stat.losses if stat else 0
        text = (
            f"📋 <b>Информация о пользователе:</b>\n\n"
            f"Имя: {u.first_name or '—'}\n"
            f"Ник: {u.nick or '—'}\n"
            f"Сообщений в чате: <b>{msgs}</b>\n"
            f"Побед: <b>{wins}</b>\n"
            f"Проигрышей: <b>{losses}</b>\n"
            f"Репутация: <b>{u.reputation}</b>"
        )
        await message.reply(text)


