# --- Профиль ---
@router.message(Command("профиль"))
async def cmd_profile(message: Message):
    target_id = message.from_user.id
    if message.reply_to_message:
        target_id = message.reply_to_message.from_user.id
    async with async_session() as session:
        user = await get_or_create_user(session, target_id)
        if not user.profile_public and target_id != message.from_user.id:
            return await message.reply("🔒 Профиль скрыт.")
        days = (datetime.utcnow() - user.created_at).days if user.created_at else 0
        text = (
            f"👤 <b>Профиль</b>\n\n"
            f"📝 Ник: <b>{user.nick or user.first_name or 'Нет'}</b>\n"
            f"📌 Статус: <b>{user.status or 'Нет'}</b>\n"
            f"⭐ Репутация: <b>{user.reputation}</b>\n"
        )
        if user.balance_public or target_id == message.from_user.id:
            text += (
                f"💰 Монетки: <b>{user.coins}</b>\n"
                f"✨ Сияния: <b>{user.sparkles}</b>\n"
                f"💎 Алмазы: <b>{user.diamonds}</b>\n"
            )
        else:
            text += f"💰 Баланс: <b>🔒 скрыт</b>\n"
        text += (
            f"🗡 Кинжалы: <b>{user.daggers}</b>\n"
            f"🔫 Пистолеты: <b>{user.pistols}</b>\n"
            f"🏆 VIP: <b>{'Да' if user.vip else 'Нет'}</b>\n"
            f"📊 Дней в боте: <b>{days}</b>\n"
            f"💬 Сообщений: <b>{user.messages_count}</b>\n"
            f"🎖 Награды: <b>{len(user.awards.split(',')) if user.awards else 0}</b>/5"
        )
        await message.reply(text)


