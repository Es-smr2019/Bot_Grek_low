@router.callback_query(F.data == "vip:buy")
async def cb_vip_buy(callback: CallbackQuery):
    async with async_session() as session:
        user = await get_or_create_user(session, callback.from_user.id)
        price = 1000
        if user.diamonds < price:
            await callback.message.edit_text("❌ Недостаточно алмазов.")
            return await callback.answer("Недостаточно средств.")
        user.diamonds -= price
        user.vip = True
        await session.commit()
        await callback.message.edit_text("👑 <b>VIP активирован!</b> Поздравляем!")
    await callback.answer("Успешно!")


