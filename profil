@router.message(lambda msg: msg.text and msg.text.lower().startswith("ник "))
async def cmd_show_nick(message: Message):
    target_id = None
    if message.reply_to_message:
        target_id = message.reply_to_message.from_user.id
    elif len(message.text.split()) >= 2 and message.text.split()[1].startswith("@"):
        uname = message.text.split()[1].replace("@", "")
        async with async_session() as session:
            res = await session.execute(select(User).where(User.username == uname))
            u = res.scalar_one_or_none()
            if u:
                target_id = u.telegram_id
    if not target_id:
        target_id = message.from_user.id
    async with async_session() as session:
        user = await get_or_create_user(session, target_id)
    await message.reply(f"📝 Ник: <b>{user.nick or 'Не установлен'}</b>")


