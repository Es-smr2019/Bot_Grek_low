def calc_race_speed(car, track_name):
    track = TRACKS[track_name]
    bonus = car.passability - track["need"]
    if bonus >= 0:
        speed = car.speed + random.randint(-10, 20) + (bonus // 2)
    else:
        speed = car.speed - track["penalty"] + random.randint(-10, 10)
    return max(10, speed)


@router.message(Command("гонки"))
async def cmd_race_bot(message: Message):
    async with async_session() as session:
        car = await get_car(session, message.from_user.id)
        if not car:
            return await message.reply("❌ Купите машину.")
        if car.fuel < 20:
            return await message.reply("⛽ Недостаточно топлива. Купите в магазине.")
        track = random.choice(list(TRACKS.keys()))
        car.fuel -= 20
        car.races += 1
        # бот машина
        bot_car = random.choice(list(CARS_SHOP.values()))
        bot_speed = bot_car["speed"] + random.randint(-10, 20)
        if bot_car["pass"] < TRACKS[track]["need"]:
            bot_speed -= TRACKS[track]["penalty"]
        player_speed = calc_race_speed(car, track)
        if player_speed > bot_speed:
            car.wins += 1
            prize = 500
            user = await get_or_create_user(session, message.from_user.id)
            user.coins += prize
            res = f"🎉 <b>Победа!</b> +{prize} монеток"
        else:
            res = "😞 Поражение..."
        await session.commit()
    text = (
        f"🏁 <b>Гонка на {track}!</b>\n\n"
        f"Ваша скорость: <b>{player_speed}</b>\n"
        f"Соперник: <b>{bot_speed}</b>\n\n"
        f"{res}"
    )
    await message.reply(text)


@router.message(lambda msg: msg.text and msg.text.lower().startswith("заезд "))
async def cmd_race_pvp(message: Message):
    if not message.reply_to_message:
        return await message.reply("Ответьте на сообщение соперника.")
    target_id = message.reply_to_message.from_user.id
    async with async_session() as session:
        car1 = await get_car(session, message.from_user.id)
        car2 = await get_car(session, target_id)
        if not car1 or not car2:
            return await message.reply("Оба участника должны иметь машины.")
        if car1.fuel < 20 or car2.fuel < 20:
            return await message.reply("У одного из участников мало топлива.")
        track = random.choice(list(TRACKS.keys()))
        car1.fuel -= 20
        car2.fuel -= 20
        car1.races += 1
        car2.races += 1
        s1 = calc_race_speed(car1, track)
        s2 = calc_race_speed(car2, track)
        if s1 > s2:
            car1.wins += 1
            winner = message.from_user.full_name
        elif s2 > s1:
            car2.wins += 1
            winner = message.reply_to_message.from_user.full_name
        else:
            winner = "Ничья!"
        await session.commit()
    text = (
        f"🏁 <b>Заезд на {track}!</b>\n\n"
        f"{message.from_user.full_name}: <b>{s1}</b>\n"
        f"{message.reply_to_message.from_user.full_name}: <b>{s2}</b>\n\n"
        f"🎉 Победитель: <b>{winner}</b>"
    )
    await message.reply(text)


@router.message(Command("топ_гонщиков"))
async def cmd_top_racers(message: Message):
    async with async_session() as session:
        res = await session.execute(
            select(Car, User).join(User, User.telegram_id == Car.user_id)
            .order_by(desc(Car.wins)).limit(20)
        )
        rows = res.all()
        if not rows:
            return await message.reply("Пока нет гонщиков.")
        text = "🏆 <b>Топ гонщиков:</b>\n\n"
        for i, (car, user) in enumerate(rows, 1):
            text += f"{i}. {user.first_name or 'User'} — {car.wins} побед\n"
        await message.reply(text)
