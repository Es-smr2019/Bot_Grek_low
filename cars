from aiogram import Router, F
from aiogram.types import Message, CallbackQuery, InlineKeyboardMarkup, InlineKeyboardButton
from aiogram.filters import Command
from sqlalchemy import select, desc, and_
from database import async_session, get_or_create_user, Car, GameState
import random
import json

router = Router()

CARS_SHOP = {
    "седан": {"coins": 5000, "type": "асфальт", "pass": 40, "speed": 70, "fuel": 80},
    "внедорожник": {"coins": 15000, "type": "гравий", "pass": 80, "speed": 50, "fuel": 100},
    "монстр": {"coins": 25000, "type": "гористая", "pass": 90, "speed": 35, "fuel": 120},
}

TRACKS = {
    "асфальт": {"need": 30, "penalty": 0},
    "гравий": {"need": 60, "penalty": 30},
    "гористая": {"need": 80, "penalty": 40},
}


async def get_car(session, user_id):
    res = await session.execute(select(Car).where(Car.user_id == user_id))
    return res.scalar_one_or_none()


@router.message(Command("магазин_машин"))
async def cmd_car_shop(message: Message):
    text = "🏎 <b>Магазин машин:</b>\n\n"
    for name, data in CARS_SHOP.items():
        text += (
            f"• <b>{name}</b> — {data['coins']}💰\n"
            f"  Тип: {data['type']}, Проходимость: {data['pass']}, Скорость: {data['speed']}\n\n"
        )
    text += "Купить: <code>+машина {название}</code>"
    await message.reply(text)


@router.message(lambda msg: msg.text and msg.text.lower().startswith("+машина "))
async def cmd_buy_car(message: Message):
    name = message.text[9:].strip().lower()
    if name not in CARS_SHOP:
        return await message.reply("Такой машины нет.")
    data = CARS_SHOP[name]
    async with async_session() as session:
        user = await get_or_create_user(session, message.from_user.id)
        if user.coins < data["coins"]:
            return await message.reply("❌ Недостаточно монеток.")
        existing = await get_car(session, message.from_user.id)
        if existing:
            return await message.reply("❌ У вас уже есть машина. Сначала продайте.")
        user.coins -= data["coins"]
        car = Car(
            user_id=message.from_user.id, car_name=name, car_type=data["type"],
            passability=data["pass"], speed=data["speed"], max_fuel=data["fuel"], fuel=data["fuel"]
        )
        session.add(car)
        await session.commit()
    await message.reply(f"✅ Вы купили <b>{name}</b>!")


