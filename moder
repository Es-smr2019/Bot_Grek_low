@router.chat_member(ChatMemberUpdatedFilter(member_status_changed=True))
async def on_chat_member(event: ChatMemberUpdated, bot: Bot):
    if not event.chat.type.startswith("group"):
        return
    if not event.new_chat_member or event.new_chat_member.status != "member":
        return
    async with async_session() as session:
        cs = await get_or_create_chat(session, event.chat.id)
        if not cs.welcome_text:
            return
        text = cs.welcome_text.replace("{users}", event.new_chat_member.user.full_name)
        try:
            await bot.send_message(event.chat.id, text)
        except Exception:
            pass


