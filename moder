    target_id = None
    if message.reply_to_message:
        target_id = message.reply_to_message.from_user.id
    elif len(parts) >= 3 and parts[2].startswith("@"):
        uname = parts[2].replace("@", "")
        async with async_session() as session:
            res = await session.execute(select(User).where(User.username == uname))
            u = res.scalar_one_or_none()
            if u:
                target_id = u.telegram_id
    if not target_id:
        return await message.reply("Укажите пользователя через ответ или @username.")
    async with async_session() as session:
        if not await is_mod(session, message.chat.id, message.from_user.id, 5):
            return await message.reply("❌ Только создатель может назначать ранги.")
        await set_chat_rank(session, message.chat.id, target_id, rank)
        await message.reply(f"✅ Пользователю установлен ранг <b>{rank}</b>.")


