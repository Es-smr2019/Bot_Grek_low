@router.message(lambda msg: msg.text and msg.text.lower().startswith("+варн "))
async def cmd_warn(message: Message):
    if not message.chat.type.startswith("group"):
        return
    parts = message.text.split(maxsplit=2)
    if len(parts) < 2:
        return await message.reply("Формат: +варн @user причина")
    target_id = None
    if message.reply_to_message:
        target_id = message.reply_to_message.from_user.id
    else:
        if parts[1].startswith("@"):
            uname = parts[1].replace("@", "")
            async with async_session() as session:
                res = await session.execute(select(User).where(User.username == uname))
                u = res.scalar_one_or_none()
                if u:
                    target_id = u.telegram_id
    if not target_id:
        return await message.reply("Укажите пользователя.")
    reason = parts[2] if len(parts) >= 3 else "Не указана"
    async with async_session() as session:
        if not await is_mod(session, message.chat.id, message.from_user.id, 1):
            return await message.reply("❌ Недостаточно прав.")
        w = Warn(chat_id=message.chat.id, user_id=target_id, reason=reason, warned_by=message.from_user.id)
        session.add(w)
        await session.commit()
        # проверка лимита
        count_res = await session.execute(
            select(func.count(Warn.id)).where(Warn.chat_id == message.chat.id, Warn.user_id == target_id)
        )
        count = count_res.scalar() or 0
        cs = await get_or_create_chat(session, message.chat.id)
        text = f"⚠️ Пользователь получил предупреждение.\nПричина: {reason}\nВсего: {count}/{cs.warn_limit}"
        if count >= cs.warn_limit:
            text += f"\n<b>Лимит достигнут! Наказание: {cs.warn_action}</b>"
            # применить наказание (упрощённо)
        await message.reply(text)


