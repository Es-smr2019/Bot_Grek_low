@router.message(Command("админы"))
async def cmd_admins(message: Message):
    if not message.chat.type.startswith("group"):
        return
    async with async_session() as session:
        if not await is_mod(session, message.chat.id, message.from_user.id, 1):
            return await message.reply("❌ Недостаточно прав.")
        result = await session.execute(
            select(ChatRank, User).join(User, User.telegram_id == ChatRank.user_id)
            .where(ChatRank.chat_id == message.chat.id, ChatRank.rank >= 1)
            .order_by(desc(ChatRank.rank))
        )
        rows = result.all()
        if not rows:
            return await message.reply("❌ В этом чате нет администраторов бота.")
        text = "👥 <b>Администраторы чата:</b>\n\n"
        for rank, user in rows:
            name = user.nick or user.first_name or f"User {user.telegram_id}"
            text += f"• Ранг {rank.rank}: {name}\n"
        await message.reply(text)


@router.message(lambda msg: msg.text and msg.text.lower().startswith("повысить "))
async def cmd_promote(message: Message):
    if not message.chat.type.startswith("group"):
        return
    parts = message.text.split()
    if len(parts) < 2:
        return await message.reply("Формат: повысить {ранг} (ответ) или повысить {ранг} @user")
