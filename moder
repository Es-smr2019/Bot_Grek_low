@router.message(lambda msg: msg.text and msg.text.lower().startswith("снять ранги"))
async def cmd_clear_ranks(message: Message):
    if not message.chat.type.startswith("group"):
        return
    async with async_session() as session:
        if not await is_mod(session, message.chat.id, message.from_user.id, 5):
            return await message.reply("❌ Только создатель.")
        parts = message.text.split()
        if len(parts) >= 3:
            try:
                rank_filter = int(parts[2])
            except ValueError:
                rank_filter = None
        else:
            rank_filter = None
        res = await session.execute(
            select(ChatRank).where(ChatRank.chat_id == message.chat.id)
        )
        ranks = res.scalars().all()
        removed = 0
        for r in ranks:
            if rank_filter is not None and r.rank != rank_filter:
                continue
            if r.rank == 5:
                continue  # не трогаем создателя
            await session.delete(r)
            removed += 1
        await session.commit()
        await message.reply(f"✅ Снято рангов: <b>{removed}</b>.")


