MUTE_PERIODS = {
    "минута": 1,
    "час": 60,
    "день": 24 * 60,
    "неделя": 7 * 24 * 60,
    "месяц": 30 * 24 * 60,
    "навсегда": 99999,
}

@router.message(lambda msg: msg.text and msg.text.lower().startswith("мут "))
async def cmd_mute(message: Message, bot: Bot):
    if not message.chat.type.startswith("group"):
        return
    parts = message.text.split(maxsplit=2)
    if len(parts) < 2:
        return await message.reply("Формат: мут {период} (ответ) [причина]")
    period_str = parts[1].lower()
    minutes = MUTE_PERIODS.get(period_str, 60)
    target_id = None
    if message.reply_to_message:
        target_id = message.reply_to_message.from_user.id
    if not target_id:
        return await message.reply("Ответьте на сообщение пользователя.")
    reason = parts[2] if len(parts) >= 3 else "Не указана"
    async with async_session() as session:
        if not await is_mod(session, message.chat.id, message.from_user.id, 1):
            return await message.reply("❌ Недостаточно прав.")
        until = datetime.utcnow() + timedelta(minutes=minutes)
        try:
            await bot.restrict_chat_member(
                chat_id=message.chat.id, user_id=target_id,
                permissions={"can_send_messages": False, "can_send_media_messages": False},
                until_date=until
            )
        except Exception:
            pass
        m = MuteRecord(user_id=target_id, chat_id=message.chat.id, muted_by=message.from_user.id, until=until)
        session.add(m)
        await session.commit()
    await message.reply(f"🔇 Пользователь заглушён на <b>{period_str}</b>.\nПричина: {reason}")


