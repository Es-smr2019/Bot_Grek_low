# --- Сбережения ---
@router.message(lambda msg: msg.text and msg.text.lower().startswith("+сбережения "))
async def cmd_deposit(message: Message):
    parts = message.text.split()
    if len(parts) < 2:
        return
    try:
        amount = int(parts[1])
    except ValueError:
        return
    if amount <= 0:
        return
    async with async_session() as session:
        user = await get_or_create_user(session, message.from_user.id)
        m = await session.execute(
            select(Marriage).where(
                or_(
                    Marriage.user1_id == user.telegram_id,
                    Marriage.user2_id == user.telegram_id
                )
            )
        )
        marriage = m.scalar_one_or_none()
        if not marriage:
            return await message.reply("❌ Сначала вступите в брак.")
        if user.coins < amount:
            return await message.reply("❌ Недостаточно монеток.")
        user.coins -= amount
        marriage.savings += amount
        await session.commit()
        await message.reply(f"✅ Внесено <b>{amount}</b> монеток в сбережения.")


