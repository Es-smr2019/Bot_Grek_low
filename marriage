                f"  Ставка: +{int(data['rate']*100)}% в субботу\n"
            )
        text += "\nИспользуйте: <code>+дом [название]</code>"
        await message.reply(text)


@router.message(lambda msg: msg.text and msg.text.lower().startswith("+дом "))
async def cmd_buy_house_select(message: Message):
    houses = {
        "шалаш": {"coins": 5000, "sparkles": 0, "diamonds": 0, "rate": 0.01},
        "домик": {"coins": 20000, "sparkles": 50, "diamonds": 0, "rate": 0.03},
        "особняк": {"coins": 100000, "sparkles": 200, "diamonds": 5, "rate": 0.05},
    }
    name = message.text.split()[1].lower()
    if name not in houses:
        return await message.reply("Такого дома нет.")
    data = houses[name]
    async with async_session() as session:
        user = await get_or_create_user(session, message.from_user.id)
        m = await session.execute(
            select(Marriage).where(
                or_(
                    Marriage.user1_id == user.telegram_id,
                    Marriage.user2_id == user.telegram_id
                )
            )
        )
        marriage = m.scalar_one_or_none()
        if not marriage:
            return await message.reply("❌ Только для семей.")
        if marriage.house_type:
            return await message.reply("У вас уже есть дом.")
        if user.coins < data["coins"] or user.sparkles < data["sparkles"] or user.diamonds < data["diamonds"]:
            return await message.reply("❌ Недостаточно средств.")
        user.coins -= data["coins"]
        user.sparkles -= data["sparkles"]
        user.diamonds -= data["diamonds"]
        marriage.house_type = name
        marriage.interest_rate = data["rate"]
        await session.commit()
        await message.reply(f"🏡 <b>Дом '{name}'</b> куплен! Ставка: +{int(data['rate']*100)}%")


# --- Проценты по субботам (можно запускать вручную или по таймеру) ---
@router.message(Command("начислить_проценты"))
async def cmd_interest(message: Message):
    # Упрощённая команда для демонстрации (в идеале через APScheduler)
    if datetime.utcnow().weekday() != 5:
        return await message.reply("Суббота? Нет. Но для теста можно форсировать владельцу.")
    async with async_session() as session:
        result = await session.execute(select(Marriage))
        marriages = result.scalars().all()
        count = 0
        for m in marriages:
            if m.savings > 0 and m.interest_rate > 0:
                bonus = int(m.savings * m.interest_rate)
                m.savings += bonus
                count += 1
        await session.commit()
    await message.reply(f"✅ Начислено процентов для <b>{count}</b> семей.")
