@router.message(lambda msg: msg.text and msg.text.lower().startswith("+сын "))
async def cmd_add_son(message: Message):
    if not message.reply_to_message:
        return await message.reply("Ответьте на сообщение ребёнка.")
    child_id = message.reply_to_message.from_user.id
    async with async_session() as session:
        parent = await get_or_create_user(session, message.from_user.id)
        m = await session.execute(
            select(Marriage).where(
                or_(
                    Marriage.user1_id == parent.telegram_id,
                    Marriage.user2_id == parent.telegram_id
                )
            )
        )
        marriage = m.scalar_one_or_none()
        if not marriage:
            return await message.reply("❌ Сначала нужно вступить в брак.")
        # проверка, не состоит ли уже в семье
        existing = await session.execute(
            select(FamilyMember).where(FamilyMember.child_id == child_id)
        )
        if existing.scalar_one_or_none():
            return await message.reply("Этот пользователь уже в семье.")
        fm = FamilyMember(family_id=marriage.id, child_id=child_id, role="son")
        session.add(fm)
        await session.commit()
        await message.reply("👦 Сын принят в семью!")


