# --- Брак ---
@router.message(lambda msg: msg.text and msg.text.lower().startswith("брак "))
async def cmd_marry(message: Message):
    if not message.reply_to_message and len(message.text.split()) < 2:
        return await message.reply("Укажите пользователя: брак @username или ответьте на сообщение.")
    target_id = None
    if message.reply_to_message:
        target_id = message.reply_to_message.from_user.id
    else:
        uname = message.text.split()[1].replace("@", "")
        async with async_session() as session:
            result = await session.execute(select(User).where(User.username == uname))
            u = result.scalar_one_or_none()
            if u:
                target_id = u.telegram_id
    if not target_id or target_id == message.from_user.id:
        return await message.reply("Некорректная цель.")
    async with async_session() as session:
        proposer = await get_or_create_user(session, message.from_user.id)
        # Проверка: уже в браке?
        existing = await session.execute(
            select(Marriage).where(
                or_(
                    and_(Marriage.user1_id == proposer.telegram_id, Marriage.user2_id == target_id),
                    and_(Marriage.user1_id == target_id, Marriage.user2_id == proposer.telegram_id),
                    or_(
                        Marriage.user1_id == proposer.telegram_id,
                        Marriage.user2_id == proposer.telegram_id
                    )
                )
            )
        )
        if existing.scalar_one_or_none():
            return await message.reply("❌ Один из вас уже в браке.")
        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="💍 Согласиться", callback_data=f"marry:yes:{proposer.telegram_id}")],
            [InlineKeyboardButton(text="❌ Отказаться", callback_data=f"marry:no:{proposer.telegram_id}")]
        ])
        await message.reply(
            f"💍 <a href='tg://user?id={proposer.telegram_id}'>Пользователь</a> "
            f"предлагает вам вступить в брак!", reply_markup=kb
        )


@router.callback_query(F.data.startswith("marry:"))
async def cb_marry(callback: CallbackQuery):
    parts = callback.data.split(":")
    action = parts[1]
    proposer_id = int(parts[2])
    if callback.from_user.id == proposer_id:
        return await callback.answer("Это не для вас.")
    if action == "no":
        await callback.message.edit_text("❌ Предложение отклонено.")
        return await callback.answer("Отклонено.")
    async with async_session() as session:
        # check again
        existing = await session.execute(
            select(Marriage).where(
                or_(
                    Marriage.user1_id == proposer_id,
                    Marriage.user2_id == proposer_id,
                    Marriage.user1_id == callback.from_user.id,
                    Marriage.user2_id == callback.from_user.id
                )
            )
        )
        if existing.scalar_one_or_none():
            return await callback.message.edit_text("❌ Кто-то уже в браке.")
        marriage = Marriage(
            user1_id=proposer_id, user2_id=callback.from_user.id,
            chat_id=callback.message.chat.id
        )
        session.add(marriage)
        await session.commit()
        await callback.message.edit_text(
            f"🎉 <b>Свадьба!</b>\n"
            f"<a href='tg://user?id={proposer_id}'>Жених</a> + "
            f"<a href='tg://user?id={callback.from_user.id}'>Невеста</a> = ❤️"
        )
        await callback.answer("Поздравляем!")


@router.message(Command("браки"))
async def cmd_marriages(message: Message):
    async with async_session() as session:
        result = await session.execute(
            select(Marriage).where(Marriage.chat_id == message.chat.id)
        )
        marriages = result.scalars().all()
        if not marriages:
            return await message.reply("В этом чате пока нет браков.")
        text = "💍 <b>Браки в чате:</b>\n\n"
        for m in marriages:
            u1 = await session.execute(select(User).where(User.telegram_id == m.user1_id))
            u2 = await session.execute(select(User).where(User.telegram_id == m.user2_id))
            user1 = u1.scalar_one_or_none()
            user2 = u2.scalar_one_or_none()
            name1 = user1.first_name or "User" if user1 else "User"
            name2 = user2.first_name or "User" if user2 else "User"
            text += f"• {name1} ❤️ {name2}\n"
        await message.reply(text)


