async def init_db():
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.create_all)


async def get_or_create_user(session: AsyncSession, telegram_id: int,
                             username: str = None, first_name: str = ""):
    result = await session.execute(select(User).where(User.telegram_id == telegram_id))
    user = result.scalar_one_or_none()
    if not user:
        user = User(telegram_id=telegram_id, username=username, first_name=first_name)
        session.add(user)
        await session.commit()
    else:
        if username and user.username != username:
            user.username = username
        if first_name and user.first_name != first_name:
            user.first_name = first_name
        await session.commit()
    return user


async def get_or_create_chat(session: AsyncSession, chat_id: int, title: str = None):
    result = await session.execute(select(ChatSettings).where(ChatSettings.chat_id == chat_id))
    cs = result.scalar_one_or_none()
    if not cs:
        cs = ChatSettings(chat_id=chat_id, chat_title=title)
        session.add(cs)
        await session.commit()
    elif title and cs.chat_title != title:
        cs.chat_title = title
        await session.commit()
    return cs


async def is_robbed(session: AsyncSession, user_id: int):
    result = await session.execute(
        select(Theft).where(Theft.target_id == user_id, Theft.active == True)
    )
    return result.scalar_one_or_none() is not None


async def get_chat_rank(session: AsyncSession, chat_id: int, user_id: int):
    result = await session.execute(
        select(ChatRank).where(ChatRank.chat_id == chat_id, ChatRank.user_id == user_id)
    )
    r = result.scalar_one_or_none()
    return r.rank if r else 0


async def set_chat_rank(session: AsyncSession, chat_id: int, user_id: int, rank: int):
    result = await session.execute(
        select(ChatRank).where(ChatRank.chat_id == chat_id, ChatRank.user_id == user_id)
    )
    r = result.scalar_one_or_none()
    if r:
        r.rank = rank
    else:
        r = ChatRank(chat_id=chat_id, user_id=user_id, rank=rank)
        session.add(r)
    await session.commit()
    return r
