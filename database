    vip_until = Column(DateTime, nullable=True)
    profile_public = Column(Boolean, default=True)
    balance_public = Column(Boolean, default=True)
    banner = Column(String, nullable=True)
    awards = Column(Text, default="")          # JSON-массив наград
    created_at = Column(DateTime, default=datetime.utcnow)
    messages_count = Column(Integer, default=0)
    daggers = Column(Integer, default=0)
    pistols = Column(Integer, default=0)
    mutes_used_this_month = Column(Integer, default=0)
    mutes_month = Column(Integer, default=0)
    level = Column(Integer, default=1)
    xp = Column(Integer, default=0)


