def ttt_board_kb(board, size, game_id, disabled=False):
    emojis = {"X": "❌", "O": "⭕", " ": "⬜"}
    kb = []
    for row in range(size):
        r = []
        for col in range(size):
            idx = row * size + col
            val = board[idx]
            if disabled or val != " ":
                r.append(InlineKeyboardButton(text=emojis[val], callback_data=f"ttt:none:{game_id}"))
            else:
                r.append(InlineKeyboardButton(text=emojis[val], callback_data=f"ttt:{idx}:{game_id}"))
        kb.append(r)
    return InlineKeyboardMarkup(inline_keyboard=kb)


def ttt_check_winner(board, size, need=3):
    # only for 3x3 default, 5x5 need=4
    lines = []
    for r in range(size):
        for c in range(size - need + 1):
            lines.append([r * size + c + i for i in range(need)])
    for c in range(size):
        for r in range(size - need + 1):
            lines.append([(r + i) * size + c for i in range(need)])
    for r in range(size - need + 1):
        for c in range(size - need + 1):
            lines.append([(r + i) * size + (c + i) for i in range(need)])
            lines.append([(r + i) * size + (c + need - 1 - i) for i in range(need)])
    for line in lines:
        vals = [board[i] for i in line]
        if vals[0] != " " and all(v == vals[0] for v in vals):
            return vals[0], line
    return None, []


async def ttt_bot_move(board, size, need=3):
    free = [i for i, v in enumerate(board) if v == " "]
    if not free:
        return None
    # try win
    for idx in free:
        board[idx] = "O"
        w, _ = ttt_check_winner(board, size, need)
        board[idx] = " "
        if w == "O":
            return idx
    # block
    for idx in free:
        board[idx] = "X"
        w, _ = ttt_check_winner(board, size, need)
        board[idx] = " "
        if w == "X":
            return idx
    return random.choice(free)


