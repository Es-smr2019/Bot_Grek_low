        )


@router.callback_query(F.data.startswith("hide:"))
async def cb_hide(callback: CallbackQuery):
    data = callback.data.split(":")[1]
    if data == "none":
        return await callback.answer()
    idx = int(data)
    async with async_session() as session:
        result = await session.execute(
            select(GameState).where(
                GameState.user_id == callback.from_user.id,
                GameState.game_type == "hide"
            )
        )
        gs = result.scalar_one_or_none()
        if not gs:
            return await callback.answer("Игра не найдена.")
        state = json.loads(gs.state_data)
        if not state["alive"]:
            return await callback.answer("Игра окончена.")
        if idx in state["opened"]:
            return await callback.answer("Уже открыто.")
        state["opened"].append(idx)
        cell = state["board"][str(idx)]
        user = await get_or_create_user(session, callback.from_user.id)
        if cell == "sun":
            state["alive"] = False
            gs.state_data = json.dumps(state)
            await session.commit()
            await callback.message.edit_text("☀ <b>Солнце!</b> Вы проиграли... 😢")
            return await callback.answer("Проигрыш!")
        elif cell == "phantom":
            state["found"] += 1
            if state["found"] >= state["total"]:
                prize = int(gs.bet * (2 + state["total"]))
                user.coins += prize
                await session.delete(gs)
                await session.commit()
                await callback.message.edit_text(
                    f"🦊 <b>Все фантомы найдены!</b>\n💰 Приз: <b>{prize}</b> монеток!"
                )
                return await callback.answer("Победа!")
        gs.state_data = json.dumps(state)
        await session.commit()
        kb = build_hide_kb(state)
        rem = state["total"] - state["found"]
        await callback.message.edit_text(
            f"🙈 <b>Прятки с Мики!</b>\nОсталось найти: <b>{rem}</b>\n"
            f"Открыто: {len(state['opened'])}/25", reply_markup=kb
        )
        return await callback.answer("Продолжаем!")


