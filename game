@router.callback_query(F.data.startswith("fortune:start:"))
async def cb_fortune_start(callback: CallbackQuery):
    game_id = int(callback.data.split(":")[2])
    async with async_session() as session:
        gs = await session.get(GameState, game_id)
        if not gs or gs.game_type != "fortune":
            return await callback.answer("Игра не найдена.")
        state = json.loads(gs.state_data)
        if state["phase"] != "joining":
            return await callback.answer("Уже началась.")
        if callback.from_user.id != state["starter"]:
            return await callback.answer("Только организатор может начать.")
        players = state["players"]
        if len(players) < 3:
            return await callback.answer("Нужно минимум 3 участника!")
        state["phase"] = "playing"
        gs.state_data = json.dumps(state)
        await session.commit()
        # Roll dice for each
        rolls = {}
        for uid in players:
            rolls[uid] = random.randint(1, 6)
        sorted_players = sorted(rolls.items(), key=lambda x: x[1], reverse=True)
        winners = sorted_players[:2]
        pot = gs.bet * len(players)
        prize = pot // 2
        # deduct bets from all
        for uid in players:
            u = await get_or_create_user(session, uid)
            u.coins -= gs.bet
        # give prizes
        for uid, roll in winners:
            u = await get_or_create_user(session, uid)
            u.coins += prize
        await session.delete(gs)
        await session.commit()
        text = "🎲 <b>Фортуна — результаты:</b>\n\n"
        for uid, roll in sorted_players:
            u = await get_or_create_user(session, uid)
            text += f"• {u.first_name or 'User'}: 🎲 {roll}\n"
        text += f"\n🏆 <b>Победители (топ-2):</b>\n"
        for uid, roll in winners:
            u = await get_or_create_user(session, uid)
            text += f"• {u.first_name or 'User'} — +{prize} монеток\n"
        await callback.message.edit_text(text)
    await callback.answer("Игра завершена!")
