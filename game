# --- КНБ ---
@router.message(lambda msg: msg.text and msg.text.lower().startswith("кнб"))
async def cmd_rps(message: Message):
    parts = message.text.lower().split()
    wins = 3
    bet = 0
    if parts:
        base = parts[0]
        if base.startswith("кнб") and len(base) > 3:
            try:
                wins = int(base[3:])
            except ValueError:
                wins = 3
    if wins < 1:
        wins = 1
    if wins > 5:
        wins = 5
    if len(parts) >= 2:
        try:
            bet = int(parts[1])
        except ValueError:
            bet = 0
    if await check_robbed(message.from_user.id):
        return await message.reply("❌ На вас нападают! Нельзя играть.")
    async with async_session() as session:
        user = await get_or_create_user(session, message.from_user.id)
        if bet > 0:
            ok, err = await can_play_async(user, bet, 999_999_999)
            if not ok:
                return await message.reply(err)
        uw = 0
        bw = 0
        history = []
        while uw < wins and bw < wins:
            pc = random.choice(["камень", "ножницы", "бумага"])
            bc = random.choice(["камень", "ножницы", "бумага"])
            if pc == bc:
                history.append(f"😐 Ничья ({pc})")
                continue
            if (pc == "камень" and bc == "ножницы") or \
               (pc == "ножницы" and bc == "бумага") or \
               (pc == "бумага" and bc == "камень"):
                uw += 1
                history.append(f"✅ Раунд за вами ({pc} vs {bc})")
            else:
                bw += 1
                history.append(f"❌ Раунд за ботом ({pc} vs {bc})")
        if bet > 0:
            if uw > bw:
                prize = bet * (wins - bw)
                user.coins += prize
                res = f"🎉 Победа! Приз: +{prize} монеток"
            else:
                user.coins -= bet
                res = f"😞 Проигрыш. -{bet} монеток"
        else:
            res = "Игра окончена!"
        await session.commit()
        text = f"🎮 Камень-Ножницы-Бумага (до {wins} побед)\n" + "\n".join(history) + f"\n\n{res}"
        await message.reply(text)


