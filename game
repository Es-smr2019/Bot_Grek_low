@router.callback_query(F.data.startswith("miki:"))
async def cb_miki(callback: CallbackQuery):
    idx = int(callback.data.split(":")[1])
    async with async_session() as session:
        result = await session.execute(
            select(GameState).where(
                GameState.user_id == callback.from_user.id,
                GameState.game_type == "miki"
            )
        )
        gs = result.scalar_one_or_none()
        if not gs:
            return await callback.answer("Игра не найдена.")
        state = json.loads(gs.state_data)
        if not state["alive"]:
            return await callback.answer("Игра окончена.")
        board = state["board"]
        if board[idx]:
            state["level"] += 1
            if state["level"] > 5:
                prize = int(gs.bet * 5)
                user = await get_or_create_user(session, callback.from_user.id)
                user.coins += prize
                await session.delete(gs)
                await session.commit()
                await callback.message.edit_text(
                    f"🎉 <b>Победа!</b> Вы спасли Мики на всех уровнях!\n💰 Приз: <b>{prize}</b> монеток!"
                )
                return await callback.answer("Победа!")
            new_board = [True, True, False]
            random.shuffle(new_board)
            state["board"] = new_board
            gs.state_data = json.dumps(state)
            await session.commit()
            kb = InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="🚪 1", callback_data="miki:0"),
                 InlineKeyboardButton(text="🚪 2", callback_data="miki:1"),
                 InlineKeyboardButton(text="🚪 3", callback_data="miki:2")]
            ])
            await callback.message.edit_text(
                f"🦊 Мики спасена! Уровень {state['level']}/5\nВыберите дверь:", reply_markup=kb
            )
            return await callback.answer("Отлично!")
        else:
            state["alive"] = False
            gs.state_data = json.dumps(state)
            await session.commit()
            await callback.message.edit_text("🐺 <b>Волк!</b> Он вас съел... 😢\nСтавка сгорела.")
            return await callback.answer("Проигрыш!")


# --- Прятки (5x5) ---
def build_hide_kb(state):
    board = state["board"]
    opened = state["opened"]
    kb = []
    for row in range(5):
        r = []
        for col in range(5):
            idx = row * 5 + col
            if idx in opened:
                val = board[str(idx)]
                txt = {"phantom": "🦊", "sun": "☀", "empty": "⭐"}[val]
                r.append(InlineKeyboardButton(text=txt, callback_data="hide:none"))
            else:
                r.append(InlineKeyboardButton(text="❓", callback_data=f"hide:{idx}"))
        kb.append(r)
    return InlineKeyboardMarkup(inline_keyboard=kb)


