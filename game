# --- Воровство ---
@router.message(lambda msg: msg.text and msg.text.lower().startswith("украсть"))
async def cmd_steal(message: Message):
    if not message.reply_to_message:
        return await message.reply("Ответьте на сообщение жертвы.")
    target_id = message.reply_to_message.from_user.id
    if target_id == message.from_user.id:
        return await message.reply("❌ Нельзя воровать у себя.")
    async with async_session() as session:
        thief = await get_or_create_user(session, message.from_user.id)
        target = await get_or_create_user(session, target_id)
        if thief.daggers < 1:
            return await message.reply("❌ Нужен хотя бы 1 кинжал.")
        existing = await session.execute(
            select(Theft).where(Theft.target_id == target_id, Theft.active == True)
        )
        if existing.scalar_one_or_none():
            return await message.reply("❌ У этой цели уже идёт ограбление.")
        if random.random() < 0.5:
            stolen = min(random.randint(100, 500), target.coins)
            if stolen > 0:
                target.coins -= stolen
                thief.coins += stolen
                thief.daggers -= 1
                await session.commit()
                await message.reply(
                    f"🗡 <b>Успешное ограбление!</b>\n"
                    f"Вы украли <b>{stolen}</b> монеток у {message.reply_to_message.from_user.full_name}."
                )
            else:
                thief.daggers -= 1
                await session.commit()
                await message.reply("🗡 У жертвы нет монет. Кинжал потрачен.")
        else:
            thief.daggers -= 1
            theft = Theft(thief_id=thief.telegram_id, target_id=target_id, chat_id=message.chat.id, active=True)
            session.add(theft)
            await session.commit()
            await message.reply(
                "🗡 <b>Ограбление провалено!</b>\n"
                "Жертва заметила вас и начала оборону. Кинжал потрачен.\n"
                "Жертва не может играть/передавать, пока не отобьётся."
            )


@router.message(Command("нападения"))
async def cmd_attacks(message: Message):
    async with async_session() as session:
        result = await session.execute(
            select(Theft).where(Theft.target_id == message.from_user.id, Theft.active == True)
        )
        thefts = result.scalars().all()
        if not thefts:
            return await message.reply("🔒 На вас нет активных нападений.")
        text = "⚠️ <b>Активные нападения:</b>\n\n"
        for t in thefts:
            thief = await get_or_create_user(session, t.thief_id)
            text += f"• {thief.first_name or 'User'} (чат {t.chat_id})\n"
        text += "\nОтветьте на сообщение вора и отправьте <code>пистолет</code>, чтобы отбиться."
        await message.reply(text)


@router.message(lambda msg: msg.text and msg.text.lower().strip() == "пистолет")
async def cmd_defend(message: Message):
    if not message.reply_to_message:
        return await message.reply("Ответьте на сообщение вора, чтобы отбиться.")
    async with async_session() as session:
        user = await get_or_create_user(session, message.from_user.id)
        if user.pistols < 1:
            return await message.reply("❌ Нужен пистолет.")
        thief_id = message.reply_to_message.from_user.id
        result = await session.execute(
            select(Theft).where(
                Theft.thief_id == thief_id,
                Theft.target_id == message.from_user.id,
                Theft.active == True
            )
        )
        theft = result.scalar_one_or_none()
        if not theft:
            return await message.reply("❌ Этот пользователь не грабит вас.")
        user.pistols -= 1
        theft.active = False
        await session.commit()
        await message.reply(
            "🔫 <b>Вы отбились!</b>\n"
            "Пистолет спас вас. Теперь вы можете играть и переводить валюту."
        )
