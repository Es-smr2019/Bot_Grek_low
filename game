@router.callback_query(F.data.startswith("ttt:"))
async def cb_ttt(callback: CallbackQuery):
    parts = callback.data.split(":")
    if parts[1] == "none":
        return await callback.answer()
    if parts[1] == "accept":
        return  # handled above
    idx = int(parts[1])
    game_id = int(parts[2])
    async with async_session() as session:
        gs = await session.get(GameState, game_id)
        if not gs or gs.game_type != "ttt":
            return await callback.answer("Игра не найдена.")
        state = json.loads(gs.state_data)
        if not state["alive"]:
            return await callback.answer("Игра окончена.")
        board = state["board"]
        size = state["size"]
        need = state["need"]
        turn = state["turn"]
        pvp = state["pvp"]
        # check whose turn
        current_player = state["player_x"] if turn == "X" else state["player_o"]
        if pvp and callback.from_user.id != current_player:
            return await callback.answer("Сейчас не ваш ход!")
        if not pvp and turn != "X":
            return await callback.answer("Подождите...")
        if board[idx] != " ":
            return await callback.answer("Клетка занята.")
        board[idx] = turn
        winner, line = ttt_check_winner(board, size, need)
        if winner:
            state["alive"] = False
            gs.state_data = json.dumps(state)
            await session.delete(gs)
            await session.commit()
            kb = ttt_board_kb(board, size, game_id, disabled=True)
            # payout
            if pvp:
                win_id = state["player_x"] if winner == "X" else state["player_o"]
                loser_id = state["player_o"] if winner == "X" else state["player_x"]
                if gs.bet > 0:
                    win_user = await get_or_create_user(session, win_id)
                    lose_user = await get_or_create_user(session, loser_id)
                    win_user.coins += gs.bet
                    lose_user.coins -= gs.bet
                    await session.commit()
                await callback.message.edit_text(
                    f"🏆 <b>Победил {winner}!</b>\nИгра окончена.", reply_markup=kb
                )
            else:
                if winner == "X":
                    if gs.bet > 0:
                        user = await get_or_create_user(session, state["player_x"])
                        user.coins += gs.bet
                        await session.commit()
                    await callback.message.edit_text(
                        f"🎉 <b>Вы победили!</b> +{gs.bet} монеток", reply_markup=kb
                    )
                else:
                    if gs.bet > 0:
                        user = await get_or_create_user(session, state["player_x"])
                        user.coins -= gs.bet
                        await session.commit()
                    await callback.message.edit_text(
                        f"😞 <b>Бот победил!</b> -{gs.bet} монеток", reply_markup=kb
                    )
            return await callback.answer("Конец!")
        if " " not in board:
            state["alive"] = False
            gs.state_data = json.dumps(state)
            await session.delete(gs)
            await session.commit()
            await callback.message.edit_text(
                "😐 <b>Ничья!</b>", reply_markup=ttt_board_kb(board, size, game_id, disabled=True)
            )
            return await callback.answer("Ничья!")
        if pvp:
            state["turn"] = "O" if turn == "X" else "X"
            gs.state_data = json.dumps(state)
            await session.commit()
            next_name = "X" if state["turn"] == "X" else "O"
            await callback.message.edit_text(
                f"❌ <b>Крестики-нолики {size}x{size}</b>\nХод: {next_name}",
                reply_markup=ttt_board_kb(board, size, game_id)
            )
            return await callback.answer("Ход сделан!")
        else:
            # bot turn
            state["turn"] = "O"
            gs.state_data = json.dumps(state)
            await session.commit()
            await callback.message.edit_text(
                f"❌ <b>Крестики-нолики {size}x{size}</b>\nБот думает...",
                reply_markup=ttt_board_kb(board, size, game_id)
            )
            move = await ttt_bot_move(board, size, need)
            if move is not None:
                board[move] = "O"
            winner, line = ttt_check_winner(board, size, need)
            if winner == "O":
                state["alive"] = False
                gs.state_data = json.dumps(state)
                await session.delete(gs)
                await session.commit()
                if gs.bet > 0:
                    user = await get_or_create_user(session, state["player_x"])
                    user.coins -= gs.bet
                    await session.commit()
                await callback.message.edit_text(
                    f"😞 <b>Бот победил!</b> -{gs.bet} монеток",
                    reply_markup=ttt_board_kb(board, size, game_id, disabled=True)
                )
                return await callback.answer("Проигрыш!")
            if " " not in board:
                state["alive"] = False
                gs.state_data = json.dumps(state)
                await session.delete(gs)
                await session.commit()
                await callback.message.edit_text(
                    "😐 <b>Ничья!</b>", reply_markup=ttt_board_kb(board, size, game_id, disabled=True)
                )
                return await callback.answer("Ничья!")
            state["turn"] = "X"
            gs.state_data = json.dumps(state)
            await session.commit()
            await callback.message.edit_text(
                f"❌ <b>Крестики-нолики {size}x{size}</b>\nВаш ход!",
                reply_markup=ttt_board_kb(board, size, game_id)
            )
            return await callback.answer("Ход бота!")


