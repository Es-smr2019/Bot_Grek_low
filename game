async def can_play_async(user, bet: int, max_bet: int):
    if bet <= 0:
        return False, "Ставка должна быть больше 0."
    if bet > max_bet:
        return False, f"Максимальная ставка: {max_bet} монеток."
    if user.coins < bet:
        return False, "❌ Недостаточно монеток."
    return True, ""


async def check_robbed(user_id: int):
    async with async_session() as session:
        return await is_robbed(session, user_id)


