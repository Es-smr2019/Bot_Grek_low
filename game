@router.message(lambda msg: msg.text and "новый год" in msg.text.lower())
async def cmd_newyear(message: Message):
    now = datetime.utcnow()
    next_year = datetime(now.year + 1, 1, 1)
    if now.month == 1 and now.day == 1:
        return await message.reply("🎉 С Новым Годом! Уже наступил!")
    diff = next_year - now
    d = diff.days
    h = diff.seconds // 3600
    m = (diff.seconds % 3600) // 60
    await message.reply(f"🎄 До Нового Года: <b>{d}д {h}ч {m}м</b>.")


