# --- Воровство ---
@router.message(lambda msg: msg.text and msg.text.lower().startswith("украсть"))
async def cmd_steal(message: Message):
    if not message.reply_to_message:
        return await message.reply("Ответьте на сообщение жертвы.")
    target_id = message.reply_to_message.from_user.id
    if target_id == message.from_user.id:
        return await message.reply("❌ Нельзя воровать у себя.")
    async with async_session() as session:
        thief = await get_or_create_user(session, message.from_user.id)
        target = await get_or_create_user(session, target_id)
        if thief.daggers < 1:
            return await message.reply("❌ Нужен хотя бы 1 кинжал.")
        existing = await session.execute(
            select(Theft).where(Theft.target_id == target_id, Theft.active == True)
        )
        if existing.scalar_one_or_none():
            return await message.reply("❌ У этой цели уже идёт ограбление.")
        if random.random() < 0.5:
            stolen = min(random.randint(100, 500), target.coins)
            if stolen > 0:
                target.coins -= stolen
                thief.coins += stolen
                thief.daggers -= 1
                await session.commit()
                await message.reply(
                    f"🗡 <b>Успешное ограбление!</b>\n"
                    f"Вы украли <b>{stolen}</b> монеток у {message.reply_to_message.from_user.full_name}."
                )
            else:
