@router.message(lambda msg: msg.text and msg.text.lower().startswith("зов "))
async def cmd_zov(message: Message):
    parts = message.text.split()
    if len(parts) < 2:
        return
    try:
        bet = int(parts[1])
    except ValueError:
        return
    if await check_robbed(message.from_user.id):
        return await message.reply("❌ На вас нападают! Нельзя играть.")
    async with async_session() as session:
        user = await get_or_create_user(session, message.from_user.id)
        max_bet = VIP_CASINO_MAX_BET if user.vip else CASINO_MAX_BET_DEFAULT
        ok, err = await can_play_async(user, bet, max_bet)
        if not ok:
            return await message.reply(err)
        now = datetime.utcnow()
        cd_res = await session.execute(
            select(GameState).where(
                GameState.user_id == user.telegram_id,
                GameState.game_type == "casino_cooldown"
            )
        )
        cd = cd_res.scalar_one_or_none()
        cooldown_sec = VIP_CASINO_COOLDOWN_SECONDS if user.vip else CASINO_COOLDOWN_SECONDS
        if cd:
            last = json.loads(cd.state_data).get("last", 0)
            if (now.timestamp() - last) < cooldown_sec:
                left = int(cooldown_sec - (now.timestamp() - last))
                return await message.reply(f"⏳ Подождите ещё {left} сек.")
        if random.random() < 0.45:
            win = bet * 2
            user.coins += win
            result = f"🎰 Джекпот! Вы выиграли <b>{win}</b> монеток!"
        else:
            user.coins -= bet
            result = f"😞 Вы проиграли <b>{bet}</b> монеток."
        if not cd:
            cd = GameState(
                user_id=user.telegram_id, game_type="casino_cooldown",
                state_data=json.dumps({"last": now.timestamp()})
            )
            session.add(cd)
        else:
            cd.state_data = json.dumps({"last": now.timestamp()})
        await session.commit()
        await message.reply(result)


