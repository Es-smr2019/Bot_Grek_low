from aiogram import Router, Bot
from aiogram.types import Message, CallbackQuery, InlineKeyboardMarkup, InlineKeyboardButton
from aiogram.filters import Command
from sqlalchemy import select
from database import async_session, User, get_or_create_user
from config import OWNER_USERNAME

router = Router()


def is_owner(message: Message) -> bool:
    return bool(message.from_user and message.from_user.username == OWNER_USERNAME)


def owner_kb() -> InlineKeyboardMarkup:
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="💰 Выдать валюту", callback_data="owner:currency")],
        [InlineKeyboardButton(text="🗡 Выдать предметы", callback_data="owner:items")],
        [InlineKeyboardButton(text="📊 Статистика", callback_data="owner:stats")],
        [InlineKeyboardButton(text="📢 Рассылка", callback_data="owner:broadcast")],
    ])


@router.message(Command("owner"))
async def cmd_owner(message: Message):
    if not is_owner(message):
        return
    await message.answer("🎛 <b>Консоль владельца</b>", reply_markup=owner_kb())


@router.callback_query(lambda c: c.data == "owner:back")
async def cb_back(callback: CallbackQuery):
    if callback.from_user.username != OWNER_USERNAME:
        return await callback.answer("❌ Нет доступа", show_alert=True)
    await callback.message.edit_text("🎛 <b>Консоль владельца</b>", reply_markup=owner_kb())


