@router.callback_query(lambda c: c.data == "owner:stats")
async def cb_stats(callback: CallbackQuery):
    if callback.from_user.username != OWNER_USERNAME:
        return await callback.answer("❌")
    async with async_session() as session:
        result = await session.execute(select(User))
        users = result.scalars().all()
        total = len(users)
        total_coins = sum(u.coins for u in users)
        total_sparkles = sum(u.sparkles for u in users)
        total_diamonds = sum(u.diamonds for u in users)
    text = (
        f"📊 <b>Статистика бота</b>\n\n"
        f"👤 Пользователей: <b>{total}</b>\n"
        f"💰 Монеток в обороте: <b>{total_coins}</b>\n"
        f"✨ Сияний в обороте: <b>{total_sparkles}</b>\n"
        f"💎 Алмазов в обороте: <b>{total_diamonds}</b>"
    )
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="◀ Назад", callback_data="owner:back")]
    ])
    await callback.message.edit_text(text, reply_markup=kb)


@router.callback_query(lambda c: c.data == "owner:broadcast")
async def cb_broadcast(callback: CallbackQuery):
    if callback.from_user.username != OWNER_USERNAME:
        return await callback.answer("❌")
    await callback.message.edit_text(
        "📢 Отправьте сообщение в ответ на это, и я разошлю его всем пользователям.\n"
        "Или используйте команду <code>/broadcast текст</code>"
    )


# Команды выдачи (через reply)
@router.message(Command("givecoins"))
async def cmd_give_coins(message: Message):
    if not is_owner(message):
        return
    args = message.text.split()
    if len(args) < 2 or not message.reply_to_message:
        return await message.reply("Ответьте на сообщение пользователя: <code>/givecoins 1000</code>")
    try:
        amount = int(args[1])
    except ValueError:
        return await message.reply("Введите число.")
    target_id = message.reply_to_message.from_user.id
    async with async_session() as session:
        user = await get_or_create_user(session, target_id)
        user.coins += amount
        await session.commit()
    await message.reply(f"✅ Выдано <b>{amount}</b> монеток пользователю.")


