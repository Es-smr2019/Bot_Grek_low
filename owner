@router.message(Command("broadcast"))
async def cmd_broadcast(message: Message, bot: Bot):
    if not is_owner(message):
        return
    text = message.text.replace("/broadcast", "").strip()
    if not text:
        return await message.reply("Введите текст после команды.")
    async with async_session() as session:
        result = await session.execute(select(User.telegram_id).distinct())
        ids = [r[0] for r in result.all()]
    count = 0
    for uid in ids:
        try:
            await bot.send_message(uid, f"📢 <b>Сообщение от администрации:</b>\n\n{text}")
            count += 1
        except Exception:
            pass
    await message.reply(f"✅ Разослано <b>{count}</b> пользователям.")
